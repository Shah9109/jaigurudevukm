{
  "name": "jaigurudev-platform",
  "version": "1.0.0",
  "description": "Jaigurudev Full-Stack Spiritual Platform (Website, Admin CMS, Chatbot, Mobile App)",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "jaigurudev",
    "spiritual",
    "ashram",
    "mern",
    "satsang"
  ],
  "author": "Jaigurudev Sanstha",
  "license": "ISC"
}
